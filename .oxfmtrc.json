{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "ignorePatterns": [
    "public/vendor/**",
    "public/coi-serviceworker.js",
    "dist/**",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml"
  ]
}
